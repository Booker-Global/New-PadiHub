# ─────────────────────────────────────────────────────────────────────────────
# PadiHub environment variables
# Copy this file to .env for local development. In production (Render), set
# these directly in the service's Environment panel. VITE_-prefixed vars are
# inlined into the client bundle at BUILD time (not read at runtime) — after
# changing one of these in Render you must trigger a rebuild, not just a
# restart. See vite.config.ts (envPrefix: ["VITE_", "SITE_"]).
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────
VITE_APP_NAME=v8 App Template
VITE_PUBLIC_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api
# Canonical server-side base URL used to build absolute links in emails and
# OAuth/hosted-checkout redirect URLs (Stripe Identity, Stripe Connect,
# invite links, password reset, etc.). Falls back to VITE_PUBLIC_URL, then
# 'https://padihub.com', if unset — but should be set explicitly in
# production to avoid localhost/preview URLs leaking into real emails.
APP_URL=http://localhost:5173

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Directory the built client assets are served from (defaults to dist/client
# relative to process.cwd() if unset — only needed if your deploy layout differs).
# CLIENT_DIR=dist/client

# CORS – comma-separated list of extra frontend origins to allow in addition to
# the built-in defaults (localhost, *.airoapp.ai, *.onrender.com, padihub.com).
# Example for a custom Render frontend URL:
#   ALLOWED_ORIGINS=https://padihub.onrender.com,https://app.padihub.com
# ALLOWED_ORIGINS=

# ── Features ──────────────────────────────────────────────────────────────────
VITE_ENABLE_SOURCE_MAPPING=true
VITE_ENABLE_SSR=true

# ── Development Tools ─────────────────────────────────────────────────────────
VITE_SHOW_DEV_TOOLS=false
# Optional: same as app id — local Docker preview sets SITE_ID; with vite envPrefix SITE_, client can link to /develop/{id}
# SITE_ID=

# ── Database ──────────────────────────────────────────────────────────────────
# Required — Postgres connection string used by drizzle (src/server/db/client.ts).
# Schema changes are applied with `npm run db:push` (drizzle-kit push) — there
# are no committed SQL migrations. ensureSchemaSync() self-heals a curated list
# of nullable columns at boot if a deploy skips db:push, but new NOT NULL
# columns or new tables still require running db:push manually.
# DATABASE_URL=******host:5432/dbname

# Generated MySQL User Credentials (auto-managed by the system)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=user_<random>
# DB_PASS=<generated_password>
# DB_NAME=<schema_name>

# ── Authentication ────────────────────────────────────────────────────────────
# Required. Signs/verifies user JWT session tokens (src/server/lib/constants.ts,
# src/server/middleware/auth.ts). The app fails fast at startup in production
# if this is missing (see REQUIRED_SECRETS in src/server/entry.ts).
# JWT_SECRET=your-secret-here
# SESSION_SECRET=your-secret-here

# ── Transactional email (Resend) ──────────────────────────────────────────────
# Required. Used for every outbound email — verification, password reset,
# support ticket confirmations + the hello@padihub.com support inbox copy,
# group/contribution/payout notifications, identity verification, etc.
# (src/server/integrations/email/resendClient.ts, emailService.ts). The app
# fails fast at startup in production if this is missing.
# RESEND_API_KEY=re_your_resend_api_key
# From address used on all outbound emails (must be a verified Resend domain/sender).
# Defaults to "PadiHub <noreply@padihub.com>" if unset.
# RESEND_FROM_EMAIL=PadiHub <noreply@padihub.com>

# ── Stripe (GB — cards, subscriptions, Connect payouts, Identity) ────────────
# Publishable key shown to the browser when collecting card details on
# /payments/methods and /savings-groups/:id/contribute (Stripe.js Elements).
# Build-time only — see note at top of file.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
# Required (server). Used by every Stripe API call: PaymentIntents, customers,
# Connect Express accounts, subscriptions, Identity verification sessions
# (src/server/integrations/payments/StripeProvider.ts,
# src/server/integrations/identity/StripeIdentityProvider.ts). The app fails
# fast at startup in production if this is missing.
# STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Signing secret for the main Stripe webhook (/api/webhooks/stripe) — verifies
# payment/subscription/invoice events (webhookStripeController.ts,
# StripeProvider.ts). Get this from the Stripe Dashboard webhook endpoint
# (or `stripe listen` in local dev).
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Signing secret for the separate Stripe Identity webhook
# (/api/identity/verify/webhook) — verifies identity.verification_session.*
# events (src/server/integrations/identity/StripeIdentityProvider.ts). This is
# a DIFFERENT webhook endpoint/secret from STRIPE_WEBHOOK_SECRET above — it
# must be configured as its own webhook endpoint in the Stripe Dashboard
# subscribed to the identity.verification_session.* events. Reported (presence
# only) by GET /api/system/health.
# STRIPE_IDENTITY_WEBHOOK_SECRET=whsec_your_identity_webhook_signing_secret
# Stripe Price IDs for the two paid subscription tiers, used when creating GB
# subscriptions (src/server/integrations/payments/StripeProvider.ts). Create
# these as recurring monthly Prices in the Stripe Dashboard.
# STRIPE_PRICE_ID_PRO_MONTHLY=price_your_pro_monthly_price_id
# STRIPE_PRICE_ID_ELITE_MONTHLY=price_your_elite_monthly_price_id

# ── Flutterwave (NG — cards, subscriptions, subaccount payouts, BVN) ─────────
# Required (server). Used for card tokenization/charges, subaccounts (payout
# destinations), and BVN identity verification
# (src/server/integrations/payments/FlutterwaveProvider.ts,
# src/server/integrations/identity/FlutterwaveIdentityProvider.ts). The app
# fails fast at startup in production if this is missing.
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_secret_key_here
# Signing secret for the Flutterwave webhook (/api/webhooks/flutterwave) —
# sent back as the "verif-hash" header and compared to this value
# (webhookFlutterwaveController.ts, FlutterwaveProvider.ts). Set the same
# value as your webhook's "Secret hash" in the Flutterwave Dashboard.
# FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret_hash
# Flutterwave payment plan IDs for the two paid subscription tiers
# (src/server/integrations/payments/FlutterwaveProvider.ts). Create these as
# recurring NGN payment plans in the Flutterwave Dashboard. Note: Flutterwave
# has no native recurring-billing engine for these — the monthly charge is
# driven by monthlySubscriptionRenewalCharge in scheduledJobs.ts, not the plan
# itself auto-billing.
# FLUTTERWAVE_PLAN_ID_NG_MONTHLY=your_pro_monthly_plan_id
# FLUTTERWAVE_PLAN_ID_NG_ELITE_MONTHLY=your_elite_monthly_plan_id
# Optional: small NGN verification amount used when saving a Flutterwave card token
# FLUTTERWAVE_PAYMENT_METHOD_SETUP_AMOUNT=50
# Optional fallback NGN amount charged monthly by the subscription-renewal job for Flutterwave
# users whose subscription_tier is somehow unrecognised (normally the amount is derived
# automatically from the user's chosen tier — Pro Group ₦5,000/mo or Elite Group ₦10,000/mo,
# see SUBSCRIPTION_TIERS in src/server/lib/constants.ts). Default 5000 (Pro Group price).
# FLUTTERWAVE_SUBSCRIPTION_AMOUNT_NGN=5000

# ── KYC / identity verification test-mode bypass ─────────────────────────────
# When set to "true" AND NODE_ENV is NOT "production", authenticated users can
# call POST /api/identity/bypass to mark themselves identity_verified without
# completing real Stripe Identity / Flutterwave BVN checks — this lets the
# rest of the flow (creating groups, contributions, payouts) be tested
# end-to-end while real ID verification is intentionally skipped. This flag
# has no effect at all when NODE_ENV=production; the check is hard-coded and
# is not skippable via this variable alone. Real users always go through the
# actual Stripe Identity (GB, hosted document+selfie flow) or Flutterwave BVN
# (NG, OTP flow) verification alongside this bypass.
# KYC_BYPASS=true

# ── GoDaddy Commerce (when skill-installed) ──────────────────────────────────
# Set by commerce-related skills when storefront features are added
# VITE_GODADDY_CLIENT_ID=<uuid-from-task-config>
# VITE_GODADDY_API_HOST=<hostname-from-GODADDY_API_BASE_URL>
# GODADDY_API_BASE_URL=https://api.dev-godaddy.com

# ── Tawk.to live chat widget ──────────────────────────────────────────────────
# (see src/lib/tawkto.ts, src/components/TawkToWidget.tsx)
# Property ID and Widget ID come from your Tawk.to dashboard's chat widget embed code
# (https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>). Widget ID defaults to "default" if unset.
# The widget is skipped entirely (no-op "Start Chat" buttons) if VITE_TAWKTO_PROPERTY_ID is unset.
# VITE_TAWKTO_PROPERTY_ID=<property-id-from-tawk-to-dashboard>
# VITE_TAWKTO_WIDGET_ID=default

# ── External APIs (when needed) ───────────────────────────────────────────────
# OPENAI_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here
